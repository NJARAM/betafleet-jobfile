# Local dev: no .env needed — every variable has a working default in docker-compose.yml.
# Production: cp .env.example .env, then set at least POSTGRES_PASSWORD and CORS_ORIGIN.

POSTGRES_PASSWORD=
POSTGRES_BIND=127.0.0.1
POSTGRES_HOST_PORT=5434

API_BIND=127.0.0.1
API_HOST_PORT=8092

# The web container serves the React app and proxies /api to the API container.
WEB_BIND=0.0.0.0
WEB_HOST_PORT=5181

# Public origin of the web app (only needed if the browser calls the API directly).
CORS_ORIGIN=http://localhost:5181

# SAP Business One goes through the integration bridge (Windows service), never direct.
# Empty = demo mode: queued invoices are marked posted with a fake A/R number.
SAP_BRIDGE_URL=
SAP_DEMO_MODE=true

# Load the prototype's sample jobs, fleet and finance data into an empty database.
SEED_SAMPLE_DATA=true

# --- Sign-in ---
# JWT signing key, at least 32 bytes. Generate one: openssl rand -base64 48
# Anyone holding it can mint a token for any user, including admin.
JWT_KEY=

# Demo accounts (one per role) share this password. Leave EMPTY in production so no demo accounts exist.
DEMO_PASSWORD=1234

# Production first run: creates the "admin" account with this temporary password (10+ chars, letters and digits).
# Admin must change it at first sign-in, then creates everyone else under Users.
ADMIN_PASSWORD=1234
